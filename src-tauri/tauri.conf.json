{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "stashpad",
  "version": "1.6.5",
  "identifier": "org.stashpad",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run vite:dev",
    "beforeBuildCommand": "npm run vite:build"
  },
  "app": {
    "windows": [
      {
        "title": "Stashpad",
        "width": 800,
        "height": 600,
        "minWidth": 375,
        "minHeight": 450,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true,
        "decorations": false,
        "transparent": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost data: blob:; connect-src *; font-src 'self' data:; media-src 'self' asset: https://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/.stashpad/**/*"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/EarMaster/stashpad/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENEQUU5NDc0NEYyQkYwRDkKUldUWjhDdFBkSlN1elM3NUpJNVpGcFNWK3Z5RkJBV0N0WExvd3lIYWw3U2FnN1ljaVFnZGRUYlkK",
      "dialog": false
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "stashpad"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "../assets/stashpad/tauri/icons/32x32.png",
      "../assets/stashpad/tauri/icons/128x128.png",
      "../assets/stashpad/tauri/icons/128x128@2x.png",
      "../assets/stashpad/tauri/icons/icon.icns",
      "../assets/stashpad/tauri/icons/icon.ico"
    ]
  }
}
